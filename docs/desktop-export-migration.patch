-/* 导出格式 */
-.typesetFormatGrid {
-  display: grid;
-  grid-template-columns: repeat(4, minmax(0, 1fr));
-  gap: 8px;
-}
-
-.typesetFormatOption {
-  display: flex;
-  flex-direction: column;
-  align-items: flex-start;
-  gap: 3px;
-  padding: 10px 12px;
-  border: 1px solid var(--border-subtle);
-  border-radius: var(--radius-md);
-  background: var(--bg-surface);
-  font-family: inherit;
-  text-align: left;
-  cursor: pointer;
-}
-
-.typesetFormatOption strong {
-  font-size: var(--fs-meta);
-  font-weight: 650;
-  color: var(--text-primary);
-}
-
-.typesetFormatOption span {
-  font-size: var(--fs-micro);
-  line-height: 1.35;
-  color: var(--text-quaternary);
-}
-
-.typesetFormatOption:hover:not(:disabled) {
-  border-color: var(--border-default, var(--border-subtle));
-  background: var(--bg-surface-hover);
-}
-
-.typesetFormatOption.is-active {
-  border-color: var(--color-primary);
-  background: var(--color-primary-bg);
-}
-
-.typesetFormatOption.is-active strong {
-  color: var(--color-primary);
-}
-
-.typesetFormatOption:disabled {
-  opacity: 0.55;
-  cursor: not-allowed;
-}
-
-@media (max-width: 1180px) {
-  .typesetMain {
-    grid-template-columns: minmax(0, 1fr) 340px;
-  }
-}
-
-/* 「文章顺序」页：序号 + 标题 + 创建日期，行内上移/下移。 */
-.typesetOrderList {
-  margin: 0;
-  padding: 0;
-  list-style: none;
-  border: 1px solid var(--border-light);
-  border-radius: var(--radius-sm);
-  overflow: hidden;
-}
-
-.typesetOrderRow {
-  display: flex;
-  align-items: center;
-  gap: 8px;
-  padding: 5px 8px;
-  border-bottom: 1px solid var(--border-subtle);
-  font-size: var(--fs-meta);
-}
-
-.typesetOrderRow:last-child { border-bottom: 0; }
-.typesetOrderRow:hover { background: var(--fill-subtle); }
-
-.typesetOrderIndex {
-  flex: 0 0 auto;
-  min-width: 20px;
-  color: var(--text-faint);
-  font-variant-numeric: tabular-nums;
-  text-align: right;
-}
-
-.typesetOrderTitle {
-  flex: 1 1 auto;
-  min-width: 0;
-  overflow: hidden;
-  color: var(--text-primary);
-  text-overflow: ellipsis;
-  white-space: nowrap;
-}
-
-.typesetOrderDate {
-  flex: 0 0 auto;
-  color: var(--text-faint);
-  font-size: var(--fs-micro);
-}
-
-.typesetOrderActions {
-  flex: 0 0 auto;
-  display: inline-flex;
-  gap: 2px;
-}
-
-.typesetOrderActions button {
-  display: inline-flex;
-  align-items: center;
-  justify-content: center;
-  width: 22px;
-  height: 22px;
-  padding: 0;
-  border: 0;
-  border-radius: 4px;
-  background: transparent;
-  color: var(--text-tertiary);
-  cursor: pointer;
-}
-
-.typesetOrderActions button:hover:not(:disabled) {
-  background: var(--fill-light);
-  color: var(--text-primary);
-}
-
-.typesetOrderActions button:disabled { opacity: 0.35; cursor: default; }
-
-.typesetOrderReset {
-  display: inline-flex;
-  align-items: center;
-  gap: 5px;
-  margin-top: 8px;
-  padding: 4px 10px;
-  border: 1px solid var(--border-light);
-  border-radius: var(--radius-sm);
-  background: transparent;
-  color: var(--text-secondary);
-  font-size: var(--fs-meta);
-  cursor: pointer;
-}
-
-.typesetOrderReset:hover:not(:disabled) {
-  background: var(--fill-subtle);
-  color: var(--text-primary);
-}
-
-.typesetOrderReset:disabled { opacity: 0.5; cursor: default; }
