-function imageWidth(ref: TypstAssetRef, contentWidthPt: number): string {
-  const width = ref.width > 0 ? ref.width * PX_TO_PT : contentWidthPt
-  if (width >= contentWidthPt || width <= 0) return '100%'
-  return `${Math.round(width)}pt`
