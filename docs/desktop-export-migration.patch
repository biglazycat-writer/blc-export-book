-function typstLanguage(language: string): { lang: string; region?: string } {
-  const [lang, region] = String(language || '')
-    .trim()
-    .toLowerCase()
-    .split('-')
-  return {
-    lang: /^[a-z]{2,3}$/.test(lang) ? lang : 'zh',
-    region: region && /^[a-z]{2}$/.test(region) ? region : lang === 'zh' ? 'cn' : undefined,
-  }
-}
