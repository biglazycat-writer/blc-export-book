-    const id = element.getAttribute(kind === 'flowCanvas' ? 'data-flow-canvas-id' : 'data-mindmap-artifact-id') || ''
-    const key = `${kind}:${id}`
-    if (!images.has(key)) images.set(key, render(kind, id))
