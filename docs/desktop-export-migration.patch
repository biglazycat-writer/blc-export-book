-function sanitizeAssetBase(asset: ExportAsset, index: number): string {
-  const base = String(asset.id || asset.fileName || '')
-    .replace(/\.[A-Za-z0-9]+$/, '')
-    .replace(/[^A-Za-z0-9_-]/g, '-')
-    .replace(/^-+|-+$/g, '')
-  return base || `asset-${pad(index + 1)}`
-}
