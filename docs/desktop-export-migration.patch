-export function withDocxBookRenderContext<T>(context: DocxBookRenderContext, render: () => T): T {
-  const previous = docxBookRenderContext
-  docxBookRenderContext = context
-  try {
-    return render()
-  } finally {
-    docxBookRenderContext = previous
-  }
-}
