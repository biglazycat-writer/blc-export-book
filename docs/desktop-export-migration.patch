-func buildWorkExportManuscript(book *workExportBook, novelID string) models.WorkExportManuscript {
-	volumeByPath := make(map[string]workExportVolume, len(book.Volumes))
-	for _, v := range book.Volumes {
-		volumeByPath[v.Path] = v
-	}
-	volumeIndex := make(map[string]int, len(book.Volumes))
-	volumes := make([]models.WorkExportVolume, 0, len(book.Volumes))
-	var ensureVolume func(string) int
-	ensureVolume = func(path string) int {
-		if index, ok := volumeIndex[path]; ok {
-			return index
-		}
-		meta := volumeByPath[path]
-		if meta.ParentPath != "" && meta.ParentPath != path {
-			ensureVolume(meta.ParentPath)
-		}
-		index := len(volumes)
-		volumeIndex[path] = index
-		volumes = append(volumes, models.WorkExportVolume{Path: path, ParentPath: meta.ParentPath, Title: firstNonEmpty(meta.Title, "正文")})
-		return index
-	}
-	chapters := make([]models.WorkExportChapter, 0, len(book.Chapters))
-	totalWords := 0
-	for _, ch := range book.Chapters {
-		totalWords += ch.WordCount
-		if ch.VolumePath != "" {
-			index := ensureVolume(ch.VolumePath)
-			volumes[index].ChapterCount++
-			volumes[index].WordCount += ch.WordCount
-		}
-		chapters = append(chapters, models.WorkExportChapter{
-			ID:         ch.ID,
-			VolumePath: ch.VolumePath,
-			Title:      ch.Title,
-			Synopsis:   ch.Synopsis,
-			Content:    ch.Raw,
-			WordCount:  ch.WordCount,
-			CreatedAt:  ch.CreatedAt,
-			UpdatedAt:  ch.UpdatedAt,
-		})
-	}
-
-	return models.WorkExportManuscript{
-		NovelID:       novelID,
-		Title:         book.Title,
-		Synopsis:      book.Synopsis,
-		WorkspaceKind: book.WorkspaceKind,
-		WordCount:     totalWords,
-		Volumes:       volumes,
-		Chapters:      chapters,
-	}
-}
