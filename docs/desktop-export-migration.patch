-function addAsset(
-  map: Map<string, ExportAsset>,
-  all: ExportAsset[],
-  key: string,
-  asset: ExportAsset,
-): void {
-  if (map.has(key)) return
-  map.set(key, asset)
-  all.push(asset)
-}
